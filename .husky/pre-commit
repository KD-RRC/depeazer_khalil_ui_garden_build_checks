#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running Prettier check..."
npm run format:check
if [ $? -ne 0 ]; then
  echo "Prettier check failed. Run 'npm run format' to fix formatting issues."
  exit 1
fi

echo "Running ESLint..."
npm run lint
if [ $? -ne 0 ]; then
  echo "ESLint check failed. Fix the errors above before committing."
  exit 1
fi

echo "Running tests..."
npm test -- --watchAll=false --passWithNoTests
if [ $? -ne 0 ]; then
  echo "Tests failed. Fix the failing tests before committing."
  exit 1
fi

echo "All checks passed! Proceeding with commit."